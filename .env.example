GLM_API_KEY=your_glm_api_key
GLM_BASE_URL=https://api.z.ai/api/anthropic
GLM_MODEL=glm-5.3

# PostgreSQL (Docker Compose exposes it on host port 5433).
# Inside docker compose the backend gets DATABASE_URL automatically;
# this line is for running uvicorn/alembic directly on the host.
DATABASE_URL=postgresql+psycopg://dibantu:dibantu_password@localhost:5433/dibantu_ai

# PostgreSQL container credentials (compose defaults shown; override
# together with DATABASE_URL if you change them).
# POSTGRES_DB=dibantu_ai
# POSTGRES_USER=dibantu
# POSTGRES_PASSWORD=dibantu_password

# Optional: browser origins allowed to call the API (CORS).
# Defaults to the Next.js frontend dev server (3000) plus its first
# fallback port (3002), on localhost and 127.0.0.1:
# http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3002

# RAG knowledge base (Step 12). Defaults shown; uncomment to override.
# KNOWLEDGE_DIR=data/knowledge
# RAG_STORE_DIR=data/rag/chroma
# RAG_EMBEDDINGS=local
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_TOP_K=3

# WhatsApp Cloud API integration (Step 17). DISABLED by default — the
# app behaves exactly as before until this is switched on deliberately.
# Get WHATSAPP_PHONE_NUMBER_ID from the Meta App dashboard (WhatsApp >
# API Setup); the access token is a permanent System User token, and
# the verify token is any string you invent and enter in the webhook
# configuration. Keep all three secret; they are never logged or
# returned by the API.
# WHATSAPP_ENABLED=false
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# App Secret from App Dashboard → App Settings → Basic. When set, every
# Meta webhook POST must carry a valid X-Hub-Signature-256 header
# (HMAC-SHA256 of the raw body with this secret) or it is rejected 403.
# Empty (default) = signature validation off.
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v25.0
# WHATSAPP_TIMEOUT_SECONDS=15
