# Version control
.git
.gitignore

# Secrets — never bake into the image
.env
.env.example

# Python artifacts
__pycache__
*.pyc
.pytest_cache

# Virtual environment
.venv

# Dev-only files, not needed at runtime
tests/
evaluation/
conftest.py
.claude

# Generated RAG artifacts — the vector store lives in the rag_data
# volume; only the source knowledge documents are baked into the image.
data/rag

# Docker metadata itself
Dockerfile
.dockerignore
docker-compose.yml
